diff --git a/test/navigation.test.js b/test/navigation.test.js
new file mode 100644
--- /dev/null
+++ b/test/navigation.test.js
@@ -0,0 +1,104 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createGame } from '../game/state.js';
+import { advanceSubtick } from '../game/realtime.js';
+import { avoidStackedArrival } from '../game/ai.js';
+
+const scene = (changes) => {
+  const game = createGame({ seed: 'f3-navigation', realtime: true });
+  const hull = game.ships.find((ship) => ship.id === 'fed-flagship');
+  return { ...game, autoConn: true, ships: changes.map((change, index) => ({ ...structuredClone(hull),
+    id: String.fromCharCode(97 + index), x: 100, y: 100, dest: null, ...change })) };
+};
+const separation = (before, after) => {
+  let closest = Infinity;
+  for (let i = 0; i < before.ships.length; i += 1) for (let j = i + 1; j < before.ships.length; j += 1) {
+    const a = before.ships[i], b = before.ships[j];
+    const aa = after.ships.find((s) => s.id === a.id), bb = after.ships.find((s) => s.id === b.id);
+    const px = a.x - b.x, py = a.y - b.y;
+    const dx = aa.x - a.x - bb.x + b.x, dy = aa.y - a.y - bb.y + b.y;
+    const d2 = dx * dx + dy * dy;
+    const t = d2 > 1e-12 ? Math.max(0, Math.min(1, -(px * dx + py * dy) / d2)) : 0;
+    closest = Math.min(closest, Math.hypot(px + dx * t, py + dy * t));
+  }
+  return closest;
+};
+
+for (const [name, ships] of [
+  ['crossing', [{ dest: { x: 140, y: 140 } }, { x: 120, y: 100, dest: { x: 80, y: 140 } }]],
+  ['overtaking', [{ dest: { x: 150, y: 100 } }, { x: 110, y: 100, dest: { x: 112, y: 100 } }]],
+  ['stationary obstruction', [{ dest: { x: 150, y: 100 } }, { x: 102, y: 100 }]],
+  ['symmetric arrival', [{ dest: { x: 110, y: 110 } }, { x: 120, y: 100, dest: { x: 110, y: 110 } }]],
+  ['drone wing', [{ className: 'Drone', dest: { x: 110, y: 110 } },
+    { className: 'Drone', x: 120, y: 100, dest: { x: 110, y: 110 } }, { x: 110, y: 113 }]],
+]) test(`F3 synchronized friendly ${name} stays separated`, () => {
+  const game = scene(ships);
+  const result = advanceSubtick(game).game;
+  assert.ok(separation(game, result) >= 1, `${name} swept separation ${separation(game, result)}`);
+});
+
+test('F3 stable-ID correction is independent of ship array order and RNG-free', () => {
+  const game = scene([{ dest: { x: 110, y: 110 } }, { x: 120, dest: { x: 110, y: 110 } }]);
+  const original = structuredClone(game);
+  const a = advanceSubtick(game).game;
+  const b = advanceSubtick({ ...game, ships: [...game.ships].reverse() }).game;
+  assert.deepEqual(a.ships, [...b.ships].reverse());
+  assert.deepEqual(game, original);
+  assert.equal(a.randomStep, game.randomStep);
+});
+
+test('F3 occupied arrival makes safe progress and either arrives or explicitly returns plot within eight corrections', () => {
+  let game = scene([{ dest: { x: 110, y: 100 } }, { x: 110, y: 100 }]);
+  const start = game.ships[0];
+  let ended = false;
+  for (let i = 0; i < 32; i += 1) {
+    const result = advanceSubtick(game);
+    assert.ok(separation(game, result.game) >= 1);
+    const ship = result.game.ships[0];
+    if (result.arrived.includes(ship.id)) assert.deepEqual({ x: ship.x, y: ship.y }, { x: 110, y: 100 });
+    game = result.game;
+    if (!ship.dest) { ended = true; break; }
+  }
+  assert.ok(ended, 'an occupied plot must finish or be returned for replanning');
+  assert.ok(Math.hypot(game.ships[0].x - start.x, game.ships[0].y - start.y) > 1);
+});
+
+test('F3 recovered blocked plot is not emitted as an arrival', () => {
+  const dest = { x: 110, y: 110 };
+  const game = scene([{ dest, navigationYield: { ...dest, ticks: 7 } },
+    { x: 120, dest, navigationYield: { ...dest, ticks: 7 } }]);
+  const result = advanceSubtick(game);
+  for (const id of result.arrived) {
+    const ship = result.game.ships.find((s) => s.id === id);
+    assert.deepEqual({ x: ship.x, y: ship.y }, dest);
+  }
+  assert.equal(result.game.ships[1].dest, null);
+  assert.ok(!result.arrived.includes('b'));
+});
+
+test('F3 a yielded course resumes once its obstruction leaves', () => {
+  const game = scene([{ dest: { x: 110, y: 100 }, navigationYield: { x: 110, y: 100, ticks: 6 } }, { x: 200 }]);
+  const result = advanceSubtick(game);
+  assert.equal(result.game.ships[0].x, 110);
+  assert.equal(result.game.ships[0].navigationYield, null);
+  assert.deepEqual(result.arrived, ['a']);
+});
+
+test('F3 manual conn, explicit noAvoid and tractor tow segments remain immutable', () => {
+  const fixtures = [
+    { game: { autoConn: false, playerShipId: 'a' }, ship: {} },
+    { game: {}, ship: { noAvoid: true } },
+    { game: {}, ship: { tow: { x: 110, y: 100, rate: 10, remaining: 10 } } },
+  ];
+  for (const fixture of fixtures) {
+    const game = { ...scene([{ dest: { x: 110, y: 100 }, ...fixture.ship }, { x: 110 }]), ...fixture.game };
+    const expected = advanceSubtick({ ...game, reimagined: false }).game.ships[0];
+    assert.deepEqual(advanceSubtick(game).game.ships[0], expected);
+  }
+});
+
+test('F3 shared captain arrival behavior remains identical in both Reimagined timings', () => {
+  const game = scene([{ dest: null }, { x: 110 }]);
+  assert.deepEqual(avoidStackedArrival(game, game.ships[0], 10, 0),
+    avoidStackedArrival({ ...game, realtime: false }, game.ships[0], 10, 0));
+});
